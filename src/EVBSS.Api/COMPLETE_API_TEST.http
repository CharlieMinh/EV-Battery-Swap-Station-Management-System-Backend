###############################################################################
# COMPLETE API TESTING - EV Battery Swap Station Management System
# Simplified Subscription Model (Fixed Monthly Price + Swap Limits)
# Created: October 21, 2025
###############################################################################

@baseUrl = http://localhost:5000/api/v1
@adminEmail = admin@evbss.local
@adminPassword = Admin123!@#
@staffEmail = staff@evbss.local
@staffPassword = Staff123!@#

# Variables will be set after running requests
@accessToken = 
@userId = 
@stationId = 
@vehicleId = 
@batteryModelId = 
@batteryUnitId = 
@subscriptionPlanId = 
@subscriptionId = 
@reservationId = 
@swapTransactionId = 
@invoiceId = 
@paymentId =

###############################################################################
# 1. AUTHENTICATION & USER MANAGEMENT
###############################################################################

### 1.1. Health Check
GET {{baseUrl}}/health
Content-Type: application/json

### 1.2. Register New User (Driver)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Nguyễn Văn A",
  "email": "driver1@test.com",
  "password": "Driver123!@#",
  "phoneNumber": "0901234567",
  "address": "123 Đường ABC, Quận 1, TP.HCM"
}

### 1.3. Login as Admin
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### 1.4. Login as Driver
# @name driverLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "driver1@test.com",
  "password": "Driver123!@#"
}

### 1.5. Get Current User Profile
GET {{baseUrl}}/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 1.6. Update User Profile
PUT {{baseUrl}}/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fullName": "Nguyễn Văn A (Updated)",
  "phoneNumber": "0901234999",
  "address": "456 Đường XYZ, Quận 2, TP.HCM"
}

### 1.7. Request Password Reset
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "driver1@test.com"
}

### 1.8. Get All Users (Admin Only)
GET {{baseUrl}}/users
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###############################################################################
# 2. STATIONS MANAGEMENT
###############################################################################

### 2.1. Get All Stations (Public)
GET {{baseUrl}}/stations
Content-Type: application/json

### 2.2. Get Station by ID
GET {{baseUrl}}/stations/{{stationId}}
Content-Type: application/json

### 2.3. Search Stations by Location
GET {{baseUrl}}/stations/search?latitude=10.7769&longitude=106.7009&radius=5000
Content-Type: application/json

### 2.4. Create New Station (Admin Only)
# @name createStation
POST {{baseUrl}}/admin/stations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Trạm Đổi Pin Quận 1",
  "address": "123 Nguyễn Huệ, Quận 1, TP.HCM",
  "latitude": 10.7769,
  "longitude": 106.7009,
  "capacity": 50,
  "operatingHours": "06:00 - 22:00 (Thứ 2 - CN)",
  "contactPhone": "0281234567",
  "contactEmail": "q1@evbss.local"
}

### 2.5. Update Station (Admin Only)
PUT {{baseUrl}}/admin/stations/{{stationId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Trạm Đổi Pin Quận 1 (Updated)",
  "capacity": 60,
  "isActive": true
}

### 2.6. Get Station Inventory
GET {{baseUrl}}/stations/{{stationId}}/inventory
Content-Type: application/json

###############################################################################
# 3. BATTERY MODELS & UNITS
###############################################################################

### 3.1. Get All Battery Models
GET {{baseUrl}}/battery-models
Content-Type: application/json

### 3.2. Get Battery Model by ID
GET {{baseUrl}}/battery-models/{{batteryModelId}}
Content-Type: application/json

### 3.3. Create Battery Model (Admin Only)
# @name createBatteryModel
POST {{baseUrl}}/battery-models
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "BM-48V-30Ah-Test",
  "voltage": 48,
  "capacity": 30,
  "manufacturer": "Samsung SDI",
  "warrantyMonths": 24
}

### 3.4. Get Battery Units by Station
GET {{baseUrl}}/battery-units?stationId={{stationId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 3.5. Get Available Batteries at Station
GET {{baseUrl}}/battery-units/available?stationId={{stationId}}&batteryModelId={{batteryModelId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 3.6. Create Battery Unit (Admin Only)
# @name createBatteryUnit
POST {{baseUrl}}/battery-units
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "serialNumber": "BAT-TEST-001",
  "batteryModelId": "{{batteryModelId}}",
  "purchaseDate": "2025-01-01T00:00:00Z",
  "status": "Full"
}

### 3.7. Update Battery Unit Status
PUT {{baseUrl}}/battery-units/{{batteryUnitId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "Charging",
  "healthPercentage": 95
}

### 3.8. Assign Battery to Station (Admin Only)
POST {{baseUrl}}/battery-units/{{batteryUnitId}}/assign-station
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "stationId": "{{stationId}}"
}

###############################################################################
# 4. VEHICLE MODELS & USER VEHICLES
###############################################################################

### 4.1. Get All Vehicle Models
GET {{baseUrl}}/vehicle-models
Content-Type: application/json

### 4.2. Get Vehicle Model by ID
GET {{baseUrl}}/vehicle-models/{{vehicleModelId}}
Content-Type: application/json

### 4.3. Get My Vehicles
GET {{baseUrl}}/vehicles/my-vehicles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 4.4. Register New Vehicle
# @name registerVehicle
POST {{baseUrl}}/vehicles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "vehicleModelId": "{{vehicleModelId}}",
  "plate": "59A-12345",
  "vin": "VF3-TEST-123456",
  "color": "Đỏ",
  "year": 2024
}

### 4.5. Get Vehicle by ID
GET {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 4.6. Update Vehicle
PUT {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "color": "Xanh",
  "currentOdometer": 5000
}

### 4.7. Delete Vehicle
DELETE {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###############################################################################
# 5. SUBSCRIPTION PLANS (SIMPLIFIED MODEL)
###############################################################################

### 5.1. Get All Subscription Plans (Public)
# ✅ NEW: Returns MonthlyPrice, MaxSwapsPerMonth, Benefits, RefundPolicy
GET {{baseUrl}}/subscription-plans
Content-Type: application/json

### 5.2. Get Subscription Plan by ID
GET {{baseUrl}}/subscription-plans/{{subscriptionPlanId}}
Content-Type: application/json

### 5.3. Get Plan Pricing Info
# ✅ NEW: Shows fixed monthly price and swap limit
GET {{baseUrl}}/subscription-plans/{{subscriptionPlanId}}/pricing
Content-Type: application/json

### 5.4. Create Subscription Plan (Admin Only)
# @name createSubscriptionPlan
POST {{baseUrl}}/subscription-plans
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Test Plan",
  "description": "Test subscription plan",
  "monthlyPrice": 600000,
  "maxSwapsPerMonth": 15,
  "batteryModelId": "{{batteryModelId}}",
  "requiresDeposit": false,
  "depositAmount": 0,
  "benefits": "Test benefits",
  "refundPolicy": "Hoàn tiền theo tỷ lệ ngày còn lại"
}

###############################################################################
# 6. USER SUBSCRIPTIONS (SIMPLIFIED MODEL)
###############################################################################

### 6.1. Subscribe to a Plan
# @name createSubscription
POST {{baseUrl}}/subscriptions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "subscriptionPlanId": "{{subscriptionPlanId}}",
  "vehicleId": "{{vehicleId}}",
  "startDate": "2025-10-21T00:00:00Z"
}

### 6.2. Get My Active Subscription
# ✅ NEW: Returns CurrentMonthSwapCount, MaxSwapsPerMonth
GET {{baseUrl}}/subscriptions/mine
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 6.3. Get Subscription Usage
# ✅ NEW: Shows "5/10 lần" format
GET {{baseUrl}}/subscriptions/mine/usage
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 6.4. Get Monthly Usage History
GET {{baseUrl}}/subscriptions/mine/monthly-usage?months=3
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 6.5. Get Subscription by ID
GET {{baseUrl}}/subscriptions/{{subscriptionId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 6.6. Cancel Subscription
POST {{baseUrl}}/subscriptions/{{subscriptionId}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Không sử dụng nữa"
}

### 6.7. Reactivate Subscription
POST {{baseUrl}}/subscriptions/{{subscriptionId}}/reactivate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 6.8. Get All User Subscriptions (Admin Only)
GET {{baseUrl}}/subscriptions?userId={{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###############################################################################
# 7. RESERVATIONS & SLOT BOOKING
###############################################################################

### 7.1. Check Available Slots at Station
GET {{baseUrl}}/slot-reservations/slots/available?stationId={{stationId}}&date=2025-10-22
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 7.2. Create Reservation
# @name createReservation
POST {{baseUrl}}/reservations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "stationId": "{{stationId}}",
  "vehicleId": "{{vehicleId}}",
  "reservationTime": "2025-10-22T10:00:00Z",
  "notes": "Cần đổi pin gấp"
}

### 7.3. Get My Reservations
GET {{baseUrl}}/reservations/my-reservations
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 7.4. Get Reservation by ID
GET {{baseUrl}}/reservations/{{reservationId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 7.5. Cancel Reservation
POST {{baseUrl}}/reservations/{{reservationId}}/cancel
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Không đến được"
}

### 7.6. Check-in Reservation (Staff/Driver)
POST {{baseUrl}}/reservations/{{reservationId}}/checkin
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 7.7. Complete Reservation (Staff)
POST {{baseUrl}}/reservations/{{reservationId}}/complete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###############################################################################
# 8. SWAP TRANSACTIONS (WITH SWAP COUNTER)
###############################################################################

### 8.1. Start Swap Transaction
# @name startSwap
POST {{baseUrl}}/swap-transactions/start
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "vehicleId": "{{vehicleId}}",
  "stationId": "{{stationId}}",
  "reservationId": "{{reservationId}}",
  "notes": "Đổi pin thường"
}

### 8.2. Complete Swap Transaction
# ✅ NEW: Increments CurrentMonthSwapCount++ after completion
# ✅ NEW: Checks if CurrentMonthSwapCount >= MaxSwapsPerMonth (blocks if exceeded)
POST {{baseUrl}}/swap-transactions/{{swapTransactionId}}/complete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "returnedBatterySerial": "BAT-OLD-001",
  "batteryHealthReturned": 85,
  "notes": "Hoàn thành đổi pin"
}

### 8.3. Get My Swap History
GET {{baseUrl}}/swap-transactions/my-history?page=1&pageSize=10
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 8.4. Get Swap Transaction by ID
GET {{baseUrl}}/swap-transactions/{{swapTransactionId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 8.5. Rate Swap Transaction
POST {{baseUrl}}/swap-transactions/{{swapTransactionId}}/rate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "rating": 5,
  "feedback": "Dịch vụ tốt, nhân viên nhiệt tình"
}

### 8.6. Get Station Swap Statistics (Admin/Staff)
GET {{baseUrl}}/swap-transactions/station/{{stationId}}/statistics?from=2025-10-01&to=2025-10-31
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###############################################################################
# 9. INVOICES & PAYMENTS
###############################################################################

### 9.1. Get My Invoices
GET {{baseUrl}}/invoices/my-invoices?page=1&pageSize=10
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 9.2. Get Invoice by ID
GET {{baseUrl}}/invoices/{{invoiceId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 9.3. Get Unpaid Invoices
GET {{baseUrl}}/invoices/my-invoices?isPaid=false
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 9.4. Create VNPay Payment URL
# @name createVnPayPayment
POST {{baseUrl}}/payments/vnpay/create-payment-url
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "invoiceId": "{{invoiceId}}",
  "returnUrl": "http://localhost:3000/payment/callback"
}

### 9.5. Get Payment by ID
GET {{baseUrl}}/payments/{{paymentId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 9.6. Get My Payment History
GET {{baseUrl}}/payments/my-payments?page=1&pageSize=10
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 9.7. Confirm Payment (Admin Only)
POST {{baseUrl}}/payments/{{paymentId}}/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "transactionId": "VNP-123456789",
  "notes": "Đã xác nhận thanh toán"
}

###############################################################################
# 10. ADMIN REPORTS & ANALYTICS
###############################################################################

### 10.1. Get System Statistics (Admin Only)
GET {{baseUrl}}/admin/statistics?from=2025-10-01&to=2025-10-31
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 10.2. Get Revenue Report (Admin Only)
GET {{baseUrl}}/admin/reports/revenue?month=10&year=2025
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 10.3. Get User Activity Report (Admin Only)
GET {{baseUrl}}/admin/reports/user-activity?userId={{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### 10.4. Get Station Performance Report (Admin Only)
GET {{baseUrl}}/admin/reports/station-performance?stationId={{stationId}}&from=2025-10-01&to=2025-10-31
Authorization: Bearer {{accessToken}}
Content-Type: application/json

###############################################################################
# 11. EDGE CASES & ERROR TESTING
###############################################################################

### 11.1. Test Swap Limit Enforcement (11th swap should fail)
# ✅ Expected Result: 400 Bad Request - "Đã đạt giới hạn 10 lần đổi pin trong tháng này"
POST {{baseUrl}}/swap-transactions/{{swapTransactionId}}/complete
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "returnedBatterySerial": "BAT-OLD-011",
  "batteryHealthReturned": 85,
  "notes": "Lần thử 11 (vượt giới hạn)"
}

### 11.2. Test Create Subscription without Active Vehicle
POST {{baseUrl}}/subscriptions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "subscriptionPlanId": "{{subscriptionPlanId}}",
  "vehicleId": "00000000-0000-0000-0000-000000000000",
  "startDate": "2025-10-21T00:00:00Z"
}

### 11.3. Test Unauthorized Access (No Token)
GET {{baseUrl}}/subscriptions/mine
Content-Type: application/json

### 11.4. Test Invalid Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "invalid@test.com",
  "password": "WrongPassword123"
}

### 11.5. Test Duplicate Vehicle Registration
POST {{baseUrl}}/vehicles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "vehicleModelId": "{{vehicleModelId}}",
  "plate": "59A-12345",
  "vin": "VF3-TEST-123456",
  "color": "Đỏ",
  "year": 2024
}

###############################################################################
# 12. COMPLETE WORKFLOW TEST SCENARIO
###############################################################################

### SCENARIO: New User → Subscribe → Swap 10 times → Test limit
# Step 1: Register → Login → Get token
# Step 2: Register vehicle
# Step 3: Get subscription plans
# Step 4: Subscribe to Basic plan (450k/10 swaps)
# Step 5: Check subscription usage (0/10)
# Step 6: Create reservation
# Step 7-16: Perform 10 swaps (counter: 1/10 → 2/10 → ... → 10/10)
# Step 17: Check usage (10/10)
# Step 18: Try 11th swap → Should get error "Đã đạt giới hạn"

###############################################################################
# NOTES FOR TESTING:
# 1. Run section 1 first to get authentication token
# 2. Copy the accessToken from login response
# 3. Replace {{accessToken}} in subsequent requests
# 4. Copy IDs from responses (stationId, vehicleId, etc.) to test related endpoints
# 5. For swap limit testing: Complete 10 swaps first, then try 11th
# 6. Check subscription usage after each swap to see counter increment
###############################################################################
