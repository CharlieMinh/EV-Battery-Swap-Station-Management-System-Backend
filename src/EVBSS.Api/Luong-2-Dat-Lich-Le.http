#   "status": "Pending"
# }

### ✅ VERIFY DATABASE AFTER STEP 1B:
# SELECT * FROM Reservations WHERE Id = 'reservationId'
# → Status = 0 (Pending)
# → UserId = [current user]
#
# SELECT * FROM Payments WHERE Id = 'paymentId'
# → Type = 1 (PayPerSwap)
# → Method = 0 (Cash)
# → Status = 0 (Pending)
# → ReservationId = reservationId
# → Amount = 50000


### ============================================================
### BƯỚC 2B: User check-in tại trạm (AUTO-CONFIRM CASH - CÁCH 2)
### Staff scan QR code → Backend auto-confirm cash payment + assign battery
