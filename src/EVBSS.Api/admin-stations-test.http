### ============================================
### ADMIN STATIONS CRUD - Test File
### ============================================
### Chỉ dành cho Admin role
### Route: /api/v1/admin/stations
### ============================================

@baseUrl = https://localhost:5194/api/v1
@adminToken = YOUR_ADMIN_JWT_TOKEN_HERE
@stationId = STATION_ID_HERE

### ============================================
### 1. CREATE STATION (Admin only)
### POST /api/v1/admin/stations
### ============================================

POST {{baseUrl}}/admin/stations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Trạm Swap Quận 1",
  "address": "123 Nguyễn Huệ, Phường Bến Nghé",
  "city": "Ho Chi Minh",
  "lat": 10.7756,
  "lng": 106.7019,
  "isActive": true
}

### ============================================
### 2. UPDATE STATION (Admin only)
### PUT /api/v1/admin/stations/{id}
### Chỉ cần cung cấp field muốn update (partial update)
### ============================================

PUT {{baseUrl}}/admin/stations/{{stationId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Trạm Swap Quận 1 (Đã cập nhật)",
  "isActive": true
}

### ============================================
### 3. UPDATE LOCATION (Admin only)
### Chỉ update tọa độ
### ============================================

PUT {{baseUrl}}/admin/stations/{{stationId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "lat": 10.7800,
  "lng": 106.7050
}

### ============================================
### 4. DEACTIVATE STATION (Admin only)
### Set IsActive = false
### ============================================

PUT {{baseUrl}}/admin/stations/{{stationId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}

### ============================================
### 5. DELETE STATION (Admin only)
### DELETE /api/v1/admin/stations/{id}
### - Nếu có pin: SOFT DELETE (set IsActive = false)
### - Nếu không có pin: HARD DELETE (xóa khỏi database)
### ============================================

DELETE {{baseUrl}}/admin/stations/{{stationId}}
Authorization: Bearer {{adminToken}}

### ============================================
### ERROR CASES - Testing validation
### ============================================

### Invalid Latitude (> 90)
POST {{baseUrl}}/admin/stations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Test Invalid Lat",
  "address": "Test Address",
  "city": "Test City",
  "lat": 100.0,
  "lng": 106.7,
  "isActive": true
}

### Invalid Longitude (< -180)
POST {{baseUrl}}/admin/stations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Test Invalid Lng",
  "address": "Test Address",
  "city": "Test City",
  "lat": 10.0,
  "lng": -200.0,
  "isActive": true
}

### Unauthorized (No token)
POST {{baseUrl}}/admin/stations
Content-Type: application/json

{
  "name": "Test Unauthorized",
  "address": "Test Address",
  "city": "Test City",
  "lat": 10.0,
  "lng": 106.0,
  "isActive": true
}

### ============================================
### FULL WORKFLOW TEST
### ============================================

### Step 1: Create a new station
# @name createStation
POST {{baseUrl}}/admin/stations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Trạm Test Workflow",
  "address": "456 Test Street",
  "city": "Ha Noi",
  "lat": 21.0285,
  "lng": 105.8542,
  "isActive": true
}

### Step 2: Update the created station
@newStationId = {{createStation.response.body.id}}

PUT {{baseUrl}}/admin/stations/{{newStationId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Trạm Test Workflow (Updated)",
  "address": "789 Updated Street"
}

### Step 3: Deactivate the station
PUT {{baseUrl}}/admin/stations/{{newStationId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}

### Step 4: Delete the station (should be HARD DELETE since no batteries)
DELETE {{baseUrl}}/admin/stations/{{newStationId}}
Authorization: Bearer {{adminToken}}

### ============================================
### NOTES:
### ============================================
### 1. Thay @adminToken bằng JWT token thực của Admin
### 2. Để lấy Admin token:
###    - POST /api/v1/auth/login với admin credentials
###    - Copy token từ response
### 3. Thay @stationId bằng ID trạm thực khi test UPDATE/DELETE
### 4. Hoặc dùng workflow test ở cuối (tự động lấy ID từ response)
